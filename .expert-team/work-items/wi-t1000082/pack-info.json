  "policy": {
    "schemaVersion": 2,
    "policyId": "cosmic-development",
    "revision": 4,
    "execution": "serial",
    "failureMapping": [
      {
        "failureCode": "verification-failed",
        "action": "block"
      },
      {
        "failureCode": "quality-gate-blocked",
        "action": "block"
      },
      {
        "failureCode": "SEMANTIC_FINDINGS_REQUIRED",
        "action": "block"
      },
      {
        "failureCode": "SEMANTIC_ARTIFACT_INVALID",
        "action": "retry-self",
        "maxAttempts": 2
      },
      {
        "failureCode": "SEMANTIC_ARTIFACT_VALIDATION_FAILED",
        "action": "retry-self",
        "maxAttempts": 2
      }
    ],
    "maxRepairIterations": 2,
    "retryContextTemplates": {
      "qa-repair": "Preserve the original requirements and affected acceptance criteria. Use stable finding IDs and retained execution evidence to repair only reproduced application defects within the same development assignment. Keep unresolved environment, login, input or business decisions blocked; do not treat them as implementation defects. After each repair, rerun affected acceptance checks with fresh evidence."
    },
    "maxRetries": 3,
    "retryableErrorPatterns": [
      "timeout",
      "connection reset",
      "temporary",
      "unavailable"
    ],
    "nonRetryableErrors": [
      "UNTRUSTED_APP_ROOT",
      "MISSING_TARGET",
      "TARGET_NOT_FOUND",
      "DELETE_CONFIRMATION_REQUIRED"
    ],
    "riskGate": {
      "checkAppRootTrust": true,
      "checkTargetIdentity": true,
      "blockDeleteWithoutConfirmation": true
    },
    "artifactCard": {
      "renderAfterVerifiedChange": true,
      "renderAfterNoOp": false,
      "neverRenderOnBlocked": true
    },
    "coordinatorRule": {
      "requiresLead": false,
      "lightweightByDefault": true
    },
    "executionGates": [],
