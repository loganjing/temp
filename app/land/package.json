{
  "name": "land",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:client",
    "test": "node --import tsx --test test/*.test.mjs",
    "start": "node --import tsx src/server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.0",
    "hono": "^4.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.3",
    "tsx": "^4.19.0",
    "@commonapp/dbkit": "file:../../vendor/@commonapp/dbkit",
    "better-sqlite3": "^11.0.0 || ^12.0.0",
    "@commonapp/attachment": "file:../../vendor/@commonapp/attachment",
    "busboy": "^1.6.0",
    "@commonapp/authkit": "file:../../vendor/@commonapp/authkit",
    "@commonapp/userkit": "file:../../vendor/@commonapp/userkit",
    "@commonapp/permissionkit": "file:../../vendor/@commonapp/permissionkit",
    "@commonapp/auditkit": "file:../../vendor/@commonapp/auditkit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21"
  }
}
