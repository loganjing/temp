    {
      "checkId": "QA-01",
      "type": "browser-ui",
      "plan": [
        {
          "requirementId": "AC-01",
          "kind": "interaction",
          "action": "以某公司提交人身份新建工单，填写主题、描述、问题分类并设置 SLA 优先级（P0-P4），提交；随后打开该工单详情。",
          "expected": "详情页显示系统生成的工单 ID、主题、描述、分类、优先级、提交人信息（含邮箱）、公司归属与创建时间，与提交内容一致。"
        },
        {
          "requirementId": "AC-01",
          "kind": "session-persistence",
          "action": "以某公司提交人身份新建工单，填写主题、描述、问题分类并设置 SLA 优先级（P0-P4），提交；随后打开该工单详情。",
          "expected": "详情页显示系统生成的工单 ID、主题、描述、分类、优先级、提交人信息（含邮箱）、公司归属与创建时间，与提交内容一致。"
        },
        {
          "requirementId": "AC-04",
          "kind": "interaction",
          "action": "创建并提交一张工单，依次观察进入分配队列后的状态、分配到业务组后的状态、处理人完成后的状态；另建一张工单在待处理状态执行取消。",
          "expected": "各阶段工单当前状态与第 4 节流转表一致（创建 → 待分配 → 待处理 → 完成，以及待处理 → 取消）；完成与取消的工单不再发生状态变更。"
        },
        {
          "requirementId": "AC-05",
          "kind": "interaction",
          "action": "为公司 A 配置两个业务组（各设置成员），配置\"分类 X → 业务组 1\"规则；以公司 A 提交人创建分类为 X 的工单；再创建一张分类无匹配规则的工单。",
          "expected": "分类为 X 的工单自动分配至业务组 1 并进入待处理状态，业务组 1 成员在工作台可见该工单；无匹配分类规则的工单保持待分配。"
        },
        {
          "requirementId": "AC-05",
          "kind": "runtime-render",
          "action": "为公司 A 配置两个业务组（各设置成员），配置\"分类 X → 业务组 1\"规则；以公司 A 提交人创建分类为 X 的工单；再创建一张分类无匹配规则的工单。",
          "expected": "分类为 X 的工单自动分配至业务组 1 并进入待处理状态，业务组 1 成员在工作台可见该工单；无匹配分类规则的工单保持待分配。"
        },
        {
          "requirementId": "AC-08",
          "kind": "interaction",
          "action": "处理人将一张待处理工单标记完成。",
          "expected": "工单状态变为完成；工单上记录处理人与处理时间；提交人邮箱收到完成通知邮件（或系统可查到该邮件的发送记录）。"
        },
        {
          "requirementId": "AC-08",
          "kind": "other",
          "action": "处理人将一张待处理工单标记完成。",
          "expected": "工单状态变为完成；工单上记录处理人与处理时间；提交人邮箱收到完成通知邮件（或系统可查到该邮件的发送记录）。"
        },
        {
          "requirementId": "AC-09",
          "kind": "interaction",
          "action": "提交人打开已完成工单，提交满意度评分；再次查看该工单。",
          "expected": "评价提交成功后，工单显示已评价及评分值；评价结果可被满意度统计读取。"
        },
        {
          "requirementId": "AC-09",
          "kind": "session-persistence",
          "action": "提交人打开已完成工单，提交满意度评分；再次查看该工单。",
          "expected": "评价提交成功后，工单显示已评价及评分值；评价结果可被满意度统计读取。"
        }
      ]
