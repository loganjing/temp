# ── 选择 authkit 或 attachment 时使用 ──────────────
JWT_SECRET=                    # 初始化脚本生成随机值；部署时保留为私密配置
CORS_ORIGIN=http://localhost:5173  # authkit SSO 前端地址；部署后改为正式域名
# APP_URL=http://localhost:3000      # attachment 公开分享链接启用时配置

# ── 灵基 MCP 通道（灵基 Skill 调用 API 时需要） ──────
# LINGEE_CONSOLE_URL=https://lingee-console.example.com
# MATCH_FIELDS=phone:phone
# 多字段映射示例（需 users 表有 user_code 列）：
# MATCH_FIELDS=phone:phone,username:user_code

# ── 灵基 SSO 通道（从灵基菜单进入时需要） ────────────
# KWORK_BASE_URL=https://lingee-console.example.com
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://<app>.<域名>/api/auth/sso/callback?appId=<OAUTH_CLIENT_ID>
#   ↑ 注意：redirect_uri 必须带 ?appId=<OAUTH_CLIENT_ID> 查询参数

# ── 可选 ──────────────────────────────────────────
# PORT=3000
# DB_PATH=./data/application.db  # 选择 dbkit 时使用；也可设为 :memory: 供临时检查
# LINGEE_TENANT_CODE=tid00001
# ADMIN_ROLE=admin
# ACTIVE_STATUS=active
