{
  "name": "@commonapp/attachment",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "busboy": "^1.6.0"
  },
  "peerDependencies": {
    "@commonapp/dbkit": "^0.2.0",
    "hono": "^4.6.0",
    "minio": "^8.0.0",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@commonapp/dbkit": {
      "optional": false
    },
    "hono": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "minio": {
      "optional": true
    }
  }
}
