{
  "name": "@commonapp/dbkit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Portable SQLite runtime compiled from the registered commonapp sources",
  "main": "./index.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0"
  },
  "types": "./index.d.ts",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
