.success-card {
  margin-top: 120rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #16a34a;
  color: #ffffff;
  font-size: 64rpx;
  line-height: 120rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 48rpx;
}

.back-btn {
  width: 100%;
  background-color: #2563eb;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.back-btn::after {
  border: none;
}
