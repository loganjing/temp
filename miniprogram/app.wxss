/* 访客登记小程序全局样式 */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

/* 表单卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.required-mark {
  color: #ff4d4f;
  margin-left: 4rpx;
}

.form-input {
  font-size: 30rpx;
  color: #333333;
  padding: 8rpx 0;
}

/* 主按钮 */
.btn-primary {
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-top: 24rpx;
}

.btn-primary[disabled] {
  background-color: #91d5ff;
  color: #ffffff;
}

/* 错误提示 */
.error-text {
  color: #ff4d4f;
  font-size: 26rpx;
  padding: 12rpx 0;
}
