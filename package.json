{
  "name": "catering-delivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "餐饮配送机器人管理系统 — Hono + SQLite 后端",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "concurrently -n web,api -c magenta,blue \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config src/server/vitest.config.ts",
    "test:watch": "vitest --config src/server/vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
