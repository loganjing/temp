{
  "name": "focus-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "专注时段记录系统：单页面番茄钟（25 分钟专注 + 5 分钟休息），自动记录当日专注并展示累计时长与时段热力图",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}